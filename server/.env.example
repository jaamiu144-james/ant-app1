# Copy this file to .env and fill in the values you have. See SETUP.md
# for what each one means and how to get it. Anything left blank just
# means that feature stays off (e.g. no Stripe key = dev mode billing).

SESSION_SECRET=
APP_URL=http://localhost:8787
PORT=8787

# MySQL — set either MYSQL_URL (what most managed MySQL hosts give you,
# e.g. mysql://user:pass@host:3306/dbname) OR the discrete vars below it.
# If MYSQL_URL is set, the discrete vars are ignored.
MYSQL_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ant_app

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FRONT=
STRIPE_PRICE_BACK=
STRIPE_PRICE_COMPLETE=

# FORCE_SECURE_COOKIE=1
