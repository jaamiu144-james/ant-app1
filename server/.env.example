# Copy this file to .env and fill in the values you have. See SETUP.md
# for what each one means and how to get it. Anything left blank just
# means that feature stays off (e.g. no Stripe key = dev mode billing).

SESSION_SECRET=
APP_URL=http://localhost:8787
PORT=8787
DB_PATH=./data/ant-app.sqlite

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FRONT=
STRIPE_PRICE_BACK=
STRIPE_PRICE_COMPLETE=

# FORCE_SECURE_COOKIE=1
